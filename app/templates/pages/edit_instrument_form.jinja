{#=====================================================
    Form for instrument status change
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<article class="form">
    <h2>Edit Instrument</h2>

    <form method="post" action="/instrument/{{instrument.id}}">
        <h3>{{instrument.name}}</h3>
        <label>
            Status
            <select name="status" required>
                <option {{'selected' if instrument.status == 'In Office - Richmond' }}>In Office - Richmond</option>
                <option {{'selected' if instrument.status == 'In Office - Mot' }}>In Office - Mot</option>
                <option {{'selected' if instrument.status == 'In Use - In Field' }}>In Use - In Field</option>
                <option {{'selected' if instrument.status == 'Out for Servicing' }}>Out for Servicing</option>
            </select>
        </label>
        <br>
        <label>
            Notes (opt)
            <textarea name="notes" placeholder="..." >{{instrument.notes}}</textarea>
        </label>
        <br>
        <button>Update</button>

    </form>

</article>

<div class="back">
    <a href="/instrument/{{instrument.id}}">Back</a>
</div>

{% endblock %}

