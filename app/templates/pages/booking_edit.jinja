{#=====================================================
    Form for editing booking
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<article class="form">

    <h2>Edit Booking</h2>

    <form method="post" action="/booking/{{ booking.id }}">

        <label>
            Instrument To Book
            <select name="instrument" value="{{booking.instrument_name}}" required>
            <option></option>
            {% for instrument in instruments %}
                <option value="{{ instrument.id }}">{{ instrument.name }}</option>
            {% endfor %}
            </select>
        </label>
        <br>
        <label>
            Person Wanting Instrument
            <select name="surveyor" value="{{booking.surveyor_name}}" required >
            <option></option>
            {% for surveyor in surveyors %}
                <option value="{{ surveyor.id }}">{{ surveyor.name }}</option>
            {% endfor %} 
            </select>
        </label>
        <br>
        <label>
            Booking Start Date
            <input name="startdate" type="datetime-local" value="{{booking.startdate}}" required>     
        </label>
        <br>
        <label>
            Booking End Date
            <input name="enddate" type="datetime-local" value="{{booking.enddate}}" required>
        </label>
        <br>      
        <label>
            <input name="flexible" type="checkbox" {{ 'checked' if booking.flexible }}>
            Flexible?
        </label>
        <br>
        <label>
            Notes
            <textarea name="notes" value="{{booking.notes}}" ></textarea>
        </label>
        <br>
        <button>Update</button>

    </form>


</article>

<div class="back">
    <a href="/bookings">Back</a>
</div>
{% endblock %}

