{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <section id="instruments">

        {% for instrument in instruments %}

            <div class="instrument">

                <header>
                    <h3>{{ instruments.name }}</h3>
                </header>

                <img src="/instrument/<int:id>/image" alt="Image of {{ instrument.name }}"> 

                <footer>
                    Status last changed: {{ instruments.status_last_changed | local | format }}
                </footer>

            </div>

        {% endfor %}

    </section>

{% endblock %}

