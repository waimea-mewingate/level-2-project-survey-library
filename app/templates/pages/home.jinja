{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <section id="instruments">
    <a href="/bookings">
        <div class="bookings">
            <h2>Bookings</h2>
        </div>
    </a>

        {% for instrument in instruments %}

            <a href="/instrument/{{instrument.id}}"> 
            <div class="instrument">

           
                <header>
                    <h2>{{ instrument.name }}</h2>
                </header>

                <img src="app/static/images/{{instrument.id}}.png" alt="Image of {{instrument.name}}">

                <h4>{{ instrument.status }} </h4>    
            

            </div>

        {% endfor %}

    </section>

{% endblock %}

