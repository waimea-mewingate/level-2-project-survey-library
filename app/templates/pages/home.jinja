{% extends 'pages/_base.jinja' %}


{% block content %}

    <section id="instruments">
    <a href="/bookings">
        <div class="bookings">
            <h2>Bookings</h2>
        </div>
    </a>

        {% for instrument in instruments %}

            <a href="/instrument/{{instrument.id}}"> 
            <div class="instrument">

                <h2>{{ instrument.name }}</h2>

                <h4>{{ instrument.status }} </h4>    
            
            </div>

        {% endfor %}

    </section>

<footer>
    <p>Maia Wingate 2026</p>
</footer>

{% endblock %}

