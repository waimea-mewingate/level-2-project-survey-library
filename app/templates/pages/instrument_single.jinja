{%extends 'pages/_base.jinja'%}

{%block content%}

<section id="instrument">
    
    <h1>{{instrument.name}}</h1>

    <article class="body">
        
        <div class="status">
            <h2>{{instrument.status}}</h2>
            <h4>Last updated: </h4> <span>{{ instrument.status_last_changed | format_human }}</span><br>
            <p>{{instrument.notes}}</p>
            <a href="/instrument/{{instrument.id}}/edit">Edit</a>
        </div>

        <div>
            <a href="/bookings">All Bookings</a><span> | </span>
            <a href="/bookings/history">History</a><span> | </span>
            <a href="/booking/new">New Booking</a>
        </div>
    </article>
    <div class="back">
        <a href="/">Back</a>
    </div>

</section>

{%endblock%}