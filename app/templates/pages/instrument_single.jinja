{%extends 'pages/_base.jinja'%}

{%block content%}

<section id="instrument">
    
    <h1>{{instrument.name}}</h1>

    <article class="body">
        
        <div class="status">
            <h2>{{instrument.status}}</h2>
            <h4>Last updated: </h4> <span>{{ instrument.status_last_changed | format_human }}</span><br>
            
            <a href="/instrument/{{instrument.id}}/edit">Update Status</a>
        </div>

        <div class="bookings">
            <a href="/bookings">All Bookings</a>
            <a href="/bookings/history">History</a>
            <a href="/booking/new">New Booking</a>
        </div>
    </article>

</section>

{%endblock%}