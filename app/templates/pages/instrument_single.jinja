{%extends 'pages/_base.jinja'%}

{%block content%}

<section id="instrument">

    <header>
        {%block image%}
        {%endblock%}
        <h2>{{instrument.name}}</h2>
    </header>

    <div class="status">
        <h2>{{instrument.status}}</h2>
        <h4>Last updated:</h4>
        <p>{{ instrument.status_last_changed | format_human }}</p>
        
        <article>
            <form method="post" action="/instrument/{{ instrument.id }}">
                <h3>Edit Instrument</h3>

                <label>
                    Status
                    <select name="status" required>
                        <option>In Office - Richmond</option>
                        <option>In Office - Mot</option>
                        <option>In Use - In Field</option>
                        <option>Out for Servicing</option>
                    </select>
                </label>
                <button>Update</button>
            </form>
        </article>

    </div>

</section>

{%endblock%}