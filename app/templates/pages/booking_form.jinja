{#=====================================================
    Form for new booking
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

<article class="form">

    <h2>New Booking</h2>

    <form method="post" action="/booking">

        <label>
            Instrument To Book
            <select name="instrument" required>
            {% for instrument in instruments %}
                <option value="{{ instrument.id }}">{{ instrument.name }}</option>
            {% endfor %}
            </select>
        </label>
        <br>
        <label>
            Person Wanting Instrument
            <select name="surveyor" required>
            {% for surveyor in surveyors %}
                <option value="{{ surveyor.id }}">{{ surveyor.name }}</option>
            {% endfor %} 
            </select>
        </label>
        <br>
        <label>
            Booking Start Date
            <input name="startdate" type="date" placeholder="YYYY-MM-DD" required>     
        </label>
        <br>
        <label>
            Booking End Date
            <input name="enddate" type="date" placeholder="YYYY-MM-DD" required>
        </label>
        <br>
        <label>
            <input name="flex" type="checkbox">
            Make Flexible?
        </label>
        <br>
        <label>
            Notes
            <textarea name="notes" placeholder="..." ></textarea>
        </label>
        <br>
        <button>Book</button>

    </form>


</article>

{% endblock %}

