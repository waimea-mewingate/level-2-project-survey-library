{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <section id="bookings">

        {% for booking in bookings %}

            <div class="booking">

           
                <header>
                    <h3> {{ booking.instrument_booked }} </h3>
                </header>

                <a href="/instrument/{{instrument.id}}">
                <img src="app/static/images/{{instrument.id}}.png" alt="Image of {{instrument.name}}">
                </a>

                <h4>Status: {{ instrument.status }} </h4>    
            

            </div>

        {% endfor %}

    </section>

{% endblock %}

