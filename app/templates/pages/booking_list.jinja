{#=====================================================
  Booking page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

<div class="nav">
    <a href="/">
        <h3>Back</h3>
    </a>
    <h3> | </h3>
    <a href="/bookings/history">
        <h3>History</h3>
    </a>
    <h3> | </h3>
    <a href="/booking/new">
        <h3>Add Booking</h3>
    </a>
    
</div>

<div class="filter">

    <h4>Filter By...</h4>
        <a href="/bookings/flex">Flexible |</a>
        <a href="/bookings/fixed">Fixed |</a>
        <a href="/bookings/12i">12i Only |</a>
        <a href="/bookings/sx10">SX10 Only |</a>
        <a href="/bookings/dini">DiNi Only |</a>
        <a href="/bookings">Clear</a>
</div>

<article class="bookings">

    <h1>Bookings</h1>

    {% for booking in bookings %}

        <article class="booking">

            <h2>{{ booking.instrument_name }} {{ "⇵" if booking.flexible }} </h2> 

            <h3>Requested from {{ booking.date_booked | format("DD-MM") }} to {{ booking.booking_end | format("DD-MM") }}</h3>
            <p><span>{{ booking.surveyor_name }}</span> requested {{ booking.created | format_human }}</p>

            <p>{{booking.notes}}</p>

            <a href="/booking/{{booking.id}}/edit">Edit</a><span> | </span> <a href="/booking/{{booking.id}}/delete">Delete</a>

        </article>

    {% else %}

        <p>No Future Bookings!</p>

    {% endfor %}

</article>

{% endblock %}

