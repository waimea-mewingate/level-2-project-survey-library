{#=====================================================
  Booking page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

<div class="filter">

    <h4>Filter By...</h4>
        <a href="/bookings/flex">Flexible |</a>
        <a href="/bookings/fixed">Fixed |</a>
        <a href="/bookings/12i">12i Only |</a>
        <a href="/bookings/sx10">SX10 Only |</a>
        <a href="/bookings/dini">DiNi Only |</a>
        <a href="/bookings">Clear</a>
    
    <a href="/bookings/history">
        <h4>History</h4>
    </a>
</div>
<div class="new">
    <a href="/booking/new">Add Booking</a>
</div>

<article class="bookings">
    <h1>Bookings</h1>


    {% for booking in bookings %}

        <article class="booking">

            <h2>{{ booking.instrument_name }} {{ "⿾" if booking.flexible }} </h2>

            <h3>Booked from {{ booking.date_booked | format("DD-MM") }} to {{ booking.booking_end | format("DD-MM") }}</h3>
            <p>Created {{ booking.created | format_human }} by {{ booking.surveyor_name }}</p>

            <a href="/booking/{{booking.id}}/edit">Edit</a>

        </article>

    {% else %}

        <p>No Bookings!</p>

    {% endfor %}

</article>

{% endblock %}

